# Environment Variables for Email Authentication
# Copy this file to .env.local and fill in your values

# Optional: Magic Code for testing without email (e.g. 123456)
TEST_LOGIN_CODE=

# Resend API Key (get from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secure-random-string-min-32-characters

# Allowed Emails (comma-separated list)
ALLOWED_EMAILS=geminiabhijeet@gmail.com

# KV (Redis)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Postgres Database
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
